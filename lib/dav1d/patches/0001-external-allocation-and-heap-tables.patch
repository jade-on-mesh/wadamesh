@@ -86,9 +86,25 @@
  * Allocate align-byte aligned memory. The return value can be released
  * by calling the dav1d_free_aligned() function.
  */
+#if DAV1D_EXTERNAL_ALLOC
+/*
+ * wadamesh: every allocation dav1d makes goes through these, supplied by the
+ * embedding firmware (src/VoxAv1Decoder.cpp), so frame buffers and context
+ * land in PSRAM instead of the scarce internal RAM. Tables that upstream keeps
+ * in .bss also come from here (dav1d_ext_alloc_tables in wedge.c/qm.c).
+ */
+void *dav1d_ext_malloc(size_t sz);
+void *dav1d_ext_realloc(void *ptr, size_t sz);
+void dav1d_ext_free(void *ptr);
+void *dav1d_ext_alloc_aligned(size_t sz, size_t align);
+void dav1d_ext_free_aligned(void *ptr);
+#endif
+
 static inline void *dav1d_alloc_aligned_internal(const size_t sz, const size_t align) {
     assert(!(align & (align - 1)));
-#ifdef _WIN32
+#if DAV1D_EXTERNAL_ALLOC
+    return dav1d_ext_alloc_aligned(sz, align);
+#elif defined(_WIN32)
     return _aligned_malloc(sz, align);
 #elif HAVE_POSIX_MEMALIGN
     void *ptr;
@@ -106,7 +122,9 @@
 }
 
 static inline void dav1d_free_aligned_internal(void *ptr) {
-#ifdef _WIN32
+#if DAV1D_EXTERNAL_ALLOC
+    dav1d_ext_free_aligned(ptr);
+#elif defined(_WIN32)
     _aligned_free(ptr);
 #else
     free(ptr);
@@ -122,10 +140,16 @@
 void dav1d_log_alloc_stats(Dav1dContext *c);
 #else
 #define dav1d_mem_pool_init(type, pool) dav1d_mem_pool_init(pool)
+#if DAV1D_EXTERNAL_ALLOC
+#define dav1d_malloc(type, sz) dav1d_ext_malloc(sz)
+#define dav1d_realloc(type, ptr, sz) dav1d_ext_realloc(ptr, sz)
+#define dav1d_free(ptr) dav1d_ext_free(ptr)
+#else
 #define dav1d_malloc(type, sz) malloc(sz)
 #define dav1d_realloc(type, ptr, sz) realloc(ptr, sz)
-#define dav1d_alloc_aligned(type, sz, align) dav1d_alloc_aligned_internal(sz, align)
 #define dav1d_free(ptr) free(ptr)
+#endif
+#define dav1d_alloc_aligned(type, sz, align) dav1d_alloc_aligned_internal(sz, align)
 #define dav1d_free_aligned(ptr) dav1d_free_aligned_internal(ptr)
 #endif /* TRACK_HEAP_ALLOCATIONS */
 
